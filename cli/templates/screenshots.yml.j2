name: Verify <<@ workflows.title @>>

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: |
            17
            <<@ workflows.java_version @>>
      - uses: gradle/actions/setup-gradle@v5
      - name: Build and lint the library
        run: ./gradlew <<@ workflows.module_path @>>:assembleRelease <<@ workflows.module_path @>>:lintDebug <<@ workflows.app_checks @>> --no-daemon
      - name: Render candidates or validate approved screenshots
        shell: bash
        run: |
          set -euo pipefail
          reference=<<@ workflows.module_directory_shell @>>/src/screenshotTestDebug/reference
          task=<<@ workflows.module_path @>>:validateDebugScreenshotTest
          if ! git ls-files -- "$reference" | awk '/\.png$/ { found = 1 } END { exit !found }'; then
            task=<<@ workflows.module_path @>>:updateDebugScreenshotTest
          fi
          ./gradlew "$task" --no-daemon
          mkdir -p screenshot-manifest
          git rev-parse HEAD > screenshot-manifest/source.txt
          : > screenshot-manifest/images.sha256
          if [[ -d "$reference" ]]; then
            find "$reference" -name '*.png' -type f -print0 | sort -z |
              xargs -0 -r sha256sum > screenshot-manifest/images.sha256
          fi
          <<@ workflows.screenshot_assertion @>>
      - name: Upload screenshots and test reports
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: <<@ workflows.module @>>-screenshot-results
          path: |
            screenshot-manifest/
            <<@ workflows.module_directory @>>/src/screenshotTestDebug/reference/
            <<@ workflows.module_directory @>>/build/reports/screenshotTest/
            <<@ workflows.module_directory @>>/build/outputs/screenshotTest-results/
